{
  "name": "narnia-solo-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Колдунья и Книга заклинаний — мобильная web-игра (движок + UI поверх разобранного контента книги)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:build": "python3 scripts/build_content.py && python3 scripts/merge_labels.py && python3 scripts/validate_content.py",
    "golden:gen": "node tools/golden-paths.ts",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright test",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright install chromium"
  },
  "dependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.0.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.0"
  }
}
